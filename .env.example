# Copie para .env.local e preencha com os dados do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor (nunca com NEXT_PUBLIC_): cofre (Vault) e integrações.
SUPABASE_SECRET_KEY=sb_secret_...
# Opcional: escritório que recebe os clientes do autocadastro (/comecar). Sem ela, usa o único escritório.
ONBOARDING_ESCRITORIO_ID=
